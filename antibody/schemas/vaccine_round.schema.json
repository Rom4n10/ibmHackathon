{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "antibody/vaccine_round.schema.json",
  "title": "Vaccine round result (phase 3, written by the CLI)",
  "type": "object",
  "required": ["run_id", "round", "rule_file", "tests_target", "results", "valid", "detected", "score", "recorded_at"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string"},
    "round": {"type": "integer", "minimum": 0},
    "rule_file": {"type": ["string", "null"], "description": "null for round 0: existing defenses only."},
    "rule_sha256": {"type": ["string", "null"]},
    "tests_target": {"type": "array", "items": {"type": "string"}},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variant_id", "status", "detected_by"],
        "additionalProperties": false,
        "properties": {
          "variant_id": {"type": "string", "pattern": "^v[0-9]{2,}$"},
          "status": {"enum": ["detected", "escaped", "invalid"]},
          "detected_by": {"type": "array", "items": {"enum": ["rule", "tests"]}},
          "detail": {"type": "string"}
        }
      }
    },
    "valid": {"type": "integer", "minimum": 0},
    "detected": {"type": "integer", "minimum": 0},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "recorded_at": {"type": "string"}
  }
}
